# Copy to .env and fill in real values for local development.
# Never commit the real .env — see docs/decisions.md ADR-001 on why secrets stay out of
# version control (general practice, not a numbered decision, but the same discipline).

SECRET_KEY=change-me-to-a-random-value
FLASK_ENV=development

DATABASE_URL=postgresql+psycopg://fdt:fdt@postgres:5432/fdt
TEST_DATABASE_URL=postgresql+psycopg://fdt:fdt@postgres:5432/fdt_test

POSTGRES_USER=fdt
POSTGRES_PASSWORD=fdt
POSTGRES_DB=fdt

REDIS_URL=redis://redis:6379/0

# Relative, not absolute — see the comment on this line in the checked-in .env for why.
VITE_API_BASE_URL=/api/v1

# Narration provider (ADR-002). Optional: with no key the assistant returns its computed
# figures with `narration_available: false` and the interface renders them unnarrated.
# The key is read by the backend only and never reaches the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=8
