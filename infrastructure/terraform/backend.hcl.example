# Copy to backend.hcl and fill in from `terraform output backend_hcl` in bootstrap/.
# Every stack is initialised with it:  terraform init -backend-config=../../backend.hcl
# (from envs/<name>/) or -backend-config=../backend.hcl (from global/).
bucket       = "fintech-analyser-tfstate-123456789012"
region       = "af-south-1"
encrypt      = true
use_lockfile = true
